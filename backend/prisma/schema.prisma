// WIN WEARS Ã¢â‚¬â€ data model
//
// Everything the public site renders lives here, so the catalogue can be
// managed from /admin without touching source files. Frontend code holds no
// product data of its own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts --

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  activity     ActivityLog[]
  ownedLeads   Lead[]           @relation("LeadOwner")
  stageChanges LeadStageEvent[] @relation("StageMovedBy")
  assignedRfqs QuoteRequest[]   @relation("RfqAssignee")
  quotations   Quotation[]      @relation("QuotationAuthor")
  orders       Order[]          @relation("OrderAuthor")
  orderChanges OrderEvent[]     @relation("OrderStatusBy")
  paymentsSeen OrderPayment[]   @relation("PaymentRecorder")
  ownedRuns    ProductionRun[]  @relation("RunOwner")
  authoredRuns ProductionRun[]  @relation("RunAuthor")
  runChanges   ProductionEvent[] @relation("RunMovedBy")
  outputsSeen  ProductionOutput[] @relation("OutputRecorder")
  inspections  QcInspection[]   @relation("Inspector")
  qcDecisions  QcInspection[]   @relation("QcDecider")
  qcAuthored   QcInspection[]   @relation("QcAuthor")
  stockMoves   StockMovement[]  @relation("StockRecorder")
  shipments    Shipment[]       @relation("ShipmentAuthor")
  shipmentMoves ShipmentEvent[] @relation("ShipmentMovedBy")

  @@index([email])
}

/// Server-side sessions. Keeping them in the database means a session can be
/// revoked immediately Ã¢â‚¬â€ a signed cookie alone cannot be taken back.
model Session {
  sid       String   @id
  userId    String?
  data      String   @db.Text
  expiresAt DateTime

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

// -------------------------------------------------------------- catalogue --

model Category {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?  @db.Text
  image            String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)

  metaTitle        String?
  metaDescription  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         Product[]
  aiConversations  AIConversation[]
  leads            Lead[]

  @@index([active, displayOrder])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())

  // --- basic
  productName      String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  fullDescription  String?       @db.Text
  categoryId       String
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0)

  // --- technical. Free text on purpose: the admin owns these values, and
  // constraining them to enums would mean a code change per new ball.
  construction           String?
  material               String?
  usage                  String?
  size                   String?
  weight                 String?
  bladder                String?
  panelCount             String?
  surface                String?
  stitching              String?
  technology             String?
  customizationAvailable Boolean @default(true)
  customizationNotes     String? @db.Text

  // --- commercial. B2B: price is optional and quoteOnly wins when set.
  price            Decimal?      @db.Decimal(10, 2)
  currency         String        @default("USD")
  priceLabel       String?
  moq              Int?
  quoteOnly        Boolean       @default(true)

  // --- seo
  metaTitle        String?
  metaDescription  String?
  keywords         String?
  ogImage          String?

  // --- system
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  /// Soft delete Ã¢â‚¬â€ Delete in the admin sets this so a mistake is recoverable.
  deletedAt        DateTime?

  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  features         ProductFeature[]
  specifications   ProductSpecification[]
  images           ProductImage[]
  quotes           QuoteRequest[]
  aiConversations  AIConversation[]
  leads            Lead[]
  quotationItems   QuotationItem[]
  orderItems       OrderItem[]
  productionRuns   ProductionRun[]
  stockItems       StockItem[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@index([productName])
  @@index([status, deletedAt, displayOrder])
}

model ProductFeature {
  id           String  @id @default(cuid())
  productId    String
  title        String
  description  String? @db.Text
  icon         String?
  displayOrder Int     @default(0)

  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model ProductSpecification {
  id           String  @id @default(cuid())
  productId    String
  label        String
  value        String
  displayOrder Int     @default(0)

  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

enum ImageType {
  MAIN
  GALLERY
  DETAIL
  CONSTRUCTION
  LIFESTYLE
  PACKAGING
}

model ProductImage {
  id           String    @id @default(cuid())
  productId    String
  /// Public URL produced by the storage driver, never a filesystem path.
  url          String
  /// Driver-specific handle, used to delete the stored object later.
  storageKey   String?
  altText      String?
  type         ImageType @default(GALLERY)
  isPrimary    Boolean   @default(false)
  width        Int?
  height       Int?
  bytes        Int?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
}

// ---------------------------------------------------------------- enquiry --

enum QuoteStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

/// Where a quote request came from. The agent's leads are worth telling apart
/// from the website form without reading the message.
enum QuoteSource {
  WEBSITE_FORM
  AI_AGENT
}

/// How soon somebody should look at an RFQ. Deliberately separate from the
/// lead score: the score is computed from what the customer told us, this is
/// what a human decided about it.
enum RfqPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model QuoteRequest {
  id                    String      @id @default(cuid())
  /// Human-quotable id shown to the customer and used in email: WW-RFQ-2026-0001.
  /// Nullable because rows created before it existed have none.
  reference             String?     @unique
  source                QuoteSource @default(WEBSITE_FORM)
  aiConversationId      String?
  /// Filled in when an enquiry is matched to an account. Nullable because a
  /// request arrives before anyone has decided who it is from, and refusing
  /// to store it until then would lose the enquiry.
  companyId             String?
  contactId             String?
  leadId                String?
  name                  String
  company               String?
  country               String?
  email                 String
  whatsapp              String?
  productId             String?
  category              String?
  quantity              Int?
  size                  String?
  customizationRequired Boolean     @default(false)
  message               String?     @db.Text
  logoFile              String?
  designFile            String?
  /// Where this request has got to in the inbox: has anyone dealt with it.
  /// The sales workflow itself lives on the linked Lead Ã¢â‚¬â€ an RFQ is the
  /// document, the lead is the opportunity, and giving each its own ten-stage
  /// pipeline would mean two that disagree.
  status                QuoteStatus @default(NEW)
  /// Who is dealing with it. Null is a real answer and worth reporting.
  assignedToId          String?
  /// What a human decided about urgency, as opposed to what the lead score
  /// computed from the customer's own words.
  priority              RfqPriority @default(NORMAL)
  followUpAt            DateTime?
  lastActivityAt        DateTime?
  /// Never returned by a public endpoint.
  internalNotes         String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  product               Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  aiConversation        AIConversation? @relation(fields: [aiConversationId], references: [id], onDelete: SetNull)
  /// `company` above is the name the customer typed; this is the account it
  /// was matched to. Both are kept Ã¢â‚¬â€ the text is evidence, the link is a
  /// judgement that can be corrected.
  companyAccount        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactPerson         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead                  Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo            User?           @relation("RfqAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  quotations            Quotation[]
  orders                Order[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([source])
  @@index([companyId])
  @@index([leadId])
  @@index([assignedToId])
  @@index([priority, status, createdAt])
  @@index([followUpAt])
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  /// The company name as the sender typed it. Kept alongside companyId:
  /// what they wrote is evidence, and matching it to an account is a
  /// judgement that can be wrong and revisited.
  company   String?
  whatsapp  String?
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  companyId String?
  contactId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  companyAccount Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactPerson  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([companyId])
}

// --------------------------------------------------------------- settings --

/// Site-wide editable values (contact details, social links, default SEO).
/// Key/value rather than one wide row, so a new setting needs no migration.
model Setting {
  key       String   @id
  value     String   @db.Text
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt

  @@index([group])
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

// --------------------------------------------------------------------- crm --
//
// The spine of the business: a company, the people at it, and the
// opportunities they represent. Everything the site already collects Ã¢â‚¬â€
// quote requests, contact messages, assistant conversations Ã¢â‚¬â€ hangs off
// these, so one buyer is one timeline rather than three unrelated rows.
//
// Deliberately not built yet: orders, production, inventory, suppliers,
// shipping. Those models describe operations WIN WEARS has not configured,
// and a schema full of tables nobody writes to is harder to change later,
// not easier.

/// What kind of buyer this is. Free-form segments were considered and
/// rejected: a fixed list is what makes "show me every academy in the UK"
/// answerable, and OTHER covers the rest without inventing a category.
enum CompanySegment {
  DISTRIBUTOR
  CLUB
  ACADEMY
  SPORTS_BRAND
  WHOLESALER
  TOURNAMENT_ORGANIZER
  RETAILER
  OTHER
}

/// Where a company or lead came from. Recorded because "which source
/// produces buyers" is a question the owner will ask, and it cannot be
/// answered retrospectively.
enum LeadSource {
  WEBSITE_FORM
  AI_ASSISTANT
  WHATSAPP
  EMAIL
  REFERRAL
  TRADE_SHOW
  MANUAL
  OTHER
}

/// The pipeline. Ordered as the business actually runs, so a Kanban board
/// reads left to right without a lookup table.
enum LeadStage {
  NEW
  QUALIFIED
  CONTACTED
  DISCOVERY
  RFQ
  QUOTATION
  NEGOTIATION
  SAMPLE
  WON
  LOST
}

model Company {
  id           String          @id @default(cuid())
  name         String
  /// Stable handle for URLs and for matching an incoming enquiry to an
  /// existing account without depending on exact capitalisation.
  slug         String          @unique
  country      String?
  website      String?
  segment      CompanySegment  @default(OTHER)
  source       LeadSource      @default(OTHER)

  /// Admin-created labels. A string array rather than a Tag table and two
  /// joins: tags here are for filtering and colour, not for hanging data
  /// off, and renaming one is a single updateMany.
  tags         String[]        @default([])

  notes        String?         @db.Text
  /// Set from real activity, never guessed Ã¢â‚¬â€ the last time anything
  /// actually happened with this account.
  lastContactAt DateTime?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  contacts     Contact[]
  leads        Lead[]
  quotes       QuoteRequest[]
  quotations   Quotation[]
  orders       Order[]
  messages     ContactMessage[]
  conversations AIConversation[]

  @@index([segment])
  @@index([country])
  @@index([name])
  @@index([lastContactAt])
}

/// A person at a company. Ã‚Â§8: an account has an owner, a purchasing manager
/// and a designer, and treating each as a separate company loses the fact
/// that they are buying together.
model Contact {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Not unique: the same person can legitimately appear under two
  /// companies, and a duplicate is better than a rejected enquiry.
  email     String?
  whatsapp  String?
  phone     String?
  jobTitle  String?
  /// Who to contact by default when the company matters more than the person.
  isPrimary Boolean  @default(false)
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads     Lead[]
  quotes    QuoteRequest[]
  quotations Quotation[]
  orders    Order[]
  messages  ContactMessage[]
  conversations AIConversation[]

  @@index([companyId])
  @@index([email])
  @@index([whatsapp])
}

/// One opportunity. A company can have several at once Ã¢â‚¬â€ a repeat customer
/// negotiating one order while sampling another is normal.
model Lead {
  id            String      @id @default(cuid())
  /// Human-quotable, like the RFQ reference: WW-LEAD-2026-0001.
  reference     String?     @unique
  title         String
  companyId     String?
  contactId     String?
  stage         LeadStage   @default(NEW)
  source        LeadSource  @default(OTHER)

  /// Scored from signals the customer gave, by lib/leadScore.ts. Reuses the
  /// assistant's enum rather than introducing a second four-value scale that
  /// would drift from it.
  score         AILeadScore @default(LOW)
  /// A human disagreeing with the score wins, and the disagreement is kept
  /// rather than overwriting it Ã¢â‚¬â€ Ã‚Â§10 asks the AI to explain itself, and an
  /// override is the most useful correction there is.
  scoreOverride AILeadScore?
  scoreReason   String?     @db.Text

  /// What they want, as far as anyone knows.
  productId     String?
  categoryId    String?
  quantity      Int?
  size          String?
  customizationRequired Boolean?
  requirements  String?     @db.Text

  /// Who is responsible. Null means nobody, which is itself worth reporting.
  ownerId       String?
  tags          String[]    @default([])

  lastActivityAt DateTime?
  nextFollowUpAt DateTime?
  /// Set once, when the lead first reaches WON or LOST.
  closedAt      DateTime?
  lostReason    String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner         User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  stageEvents   LeadStageEvent[]
  quotes        QuoteRequest[]
  quotations    Quotation[]
  orders        Order[]
  conversations AIConversation[]

  @@index([stage])
  @@index([companyId])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@index([stage, score, lastActivityAt])
  @@index([createdAt])
}

/// Every stage movement, kept forever. Ã‚Â§9 asks for movements to be logged;
/// this is also the only way to answer how long a lead sat in negotiation,
/// which is the question that follows.
model LeadStageEvent {
  id        String    @id @default(cuid())
  leadId    String
  fromStage LeadStage?
  toStage   LeadStage
  byUserId  String?
  note      String?
  createdAt DateTime  @default(now())

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  by        User?     @relation("StageMovedBy", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// -------------------------------------------------------------- quoting --
//
// A quotation is the priced document sent to a buyer, as distinct from the
// QuoteRequest above, which is them asking. One request usually becomes one
// quotation, but a negotiation can produce several.

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

model Quotation {
  id            String          @id @default(cuid())
  /// Quoted to the customer and used in email: WW-Q-2026-0001.
  number        String          @unique
  status        QuotationStatus @default(DRAFT)

  companyId     String?
  contactId     String?
  leadId        String?
  /// The request this answers, when it answers one.
  requestId     String?

  /// Currency is per quotation, not a site setting: a manufacturer quoting
  /// a UK club and a Gulf distributor is quoting in two currencies.
  currency      String          @default("USD")

  /// Every figure below is entered by a person. Nothing here is estimated,
  /// suggested by a model, or carried over from another quotation Ã¢â‚¬â€ Ã‚Â§13 is
  /// explicit that pricing is never invented, and a default price is an
  /// invented price that looks authoritative.
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  discountType  DiscountType    @default(NONE)
  /// A percentage when discountType is PERCENT, otherwise money.
  discountInput Decimal         @default(0) @db.Decimal(12, 2)
  discountValue Decimal         @default(0) @db.Decimal(12, 2)
  shipping      Decimal         @default(0) @db.Decimal(12, 2)
  taxRate       Decimal         @default(0) @db.Decimal(5, 2)
  taxValue      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)

  paymentTerms  String?
  packaging     String?
  leadTime      String?
  validUntil    DateTime?
  /// Shown on the document.
  notes         String?         @db.Text
  /// Never rendered on the document or returned to a customer.
  internalNotes String?         @db.Text

  createdById   String?
  sentAt        DateTime?
  decidedAt     DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company       Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead          Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  request       QuoteRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("QuotationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  items         QuotationItem[]
  order         Order?

  @@index([status])
  @@index([companyId])
  @@index([leadId])
  @@index([createdAt])
  @@index([validUntil])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  productId    String?
  /// Free text, because a quotation line is often "as sampled, with your
  /// crest on panels 3 and 5" rather than a catalogue product.
  description  String
  quantity     Int
  unitPrice    Decimal   @db.Decimal(12, 2)
  /// quantity Ãƒâ€” unitPrice, stored rather than derived so a historic
  /// quotation still adds up if rounding rules ever change.
  lineTotal    Decimal   @db.Decimal(12, 2)
  displayOrder Int       @default(0)

  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId, displayOrder])
}

// --------------------------------------------------------------- orders --
//
// What an accepted quotation becomes. The quotation is an offer; the order is
// the commitment, and from here the questions stop being "what would this
// cost" and start being "when does it ship and has the deposit landed".
//
// Prices are copied from the accepted quotation and not recalculated from the
// catalogue. That is the one place copying a price is right: it is the price
// the customer agreed to, and quoting them a different one later is exactly
// the failure the pricing rule exists to prevent.

/// Where an order has got to. Production and shipping will each want more
/// detail than this when they are built; this stays the one-line answer to
/// "where is my order", which is the question a customer actually asks.
enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

model Order {
  id            String        @id @default(cuid())
  /// Quoted to the customer and printed on the paperwork: WW-SO-2026-0001.
  number        String        @unique
  status        OrderStatus   @default(CONFIRMED)

  companyId     String?
  contactId     String?
  leadId        String?
  /// One order per quotation. A second order against the same accepted
  /// quotation is almost always somebody clicking Convert twice, and the
  /// database should refuse it rather than the screen remembering not to.
  quotationId   String?       @unique
  requestId     String?

  /// The customer's own purchase order reference. They will use it in every
  /// email about this order and will not know ours.
  poNumber      String?

  currency      String        @default("USD")

  /// Carried from the quotation the customer accepted, then frozen. Nothing
  /// here is estimated or recalculated.
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discountType  DiscountType  @default(NONE)
  discountInput Decimal       @default(0) @db.Decimal(12, 2)
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  shipping      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  taxValue      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)

  paymentTerms  String?
  packaging     String?

  /// What the customer asked for and what we committed to. Kept apart because
  /// the gap between them is the thing worth reporting on, and collapsing
  /// them into one date loses whether a late order was ever promised on time.
  requiredBy    DateTime?
  promisedAt    DateTime?

  /// Free text. A delivery address is a block that gets printed on a label,
  /// and structuring it now would be inventing a shape for the shipping
  /// module before anyone has said what it needs.
  shipTo        String?       @db.Text

  /// Shown on the paperwork.
  notes         String?       @db.Text
  /// Never rendered on anything a customer sees.
  internalNotes String?       @db.Text

  createdById   String?
  confirmedAt   DateTime      @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotation     Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  request       QuoteRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("OrderAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  items         OrderItem[]
  payments      OrderPayment[]
  events        OrderEvent[]
  runs          ProductionRun[]
  inspections   QcInspection[]
  stockMoves    StockMovement[]
  shipments     Shipment[]

  @@index([status])
  @@index([companyId])
  @@index([leadId])
  @@index([createdAt])
  @@index([promisedAt])
  @@index([status, promisedAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  description  String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  displayOrder Int      @default(0)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  runs         ProductionRun[]
  shipped      ShipmentItem[]

  @@index([orderId, displayOrder])
}

/// Money that actually arrived. Never inferred from a status, never assumed
/// from payment terms: "50% deposit" is what was agreed, not evidence that
/// half the money is in the bank.
model OrderPayment {
  id           String   @id @default(cuid())
  orderId      String
  amount       Decimal  @db.Decimal(12, 2)
  /// Free text: bank transfer, letter of credit, whatever was used.
  method       String?
  /// The bank's reference, so a line on a statement can be found again.
  reference    String?
  receivedAt   DateTime @default(now())
  note         String?
  recordedById String?

  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy   User?    @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([orderId, receivedAt])
}

/// Every status movement, kept forever Ã¢â‚¬â€ the same reason LeadStageEvent
/// exists. "When did this go into production" is unanswerable from a single
/// status column, and it is the question asked when an order runs late.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  byUserId   String?
  note       String?
  createdAt  DateTime     @default(now())

  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  by         User?        @relation("OrderStatusBy", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// -------------------------------------------------------- manufacturing --
//
// A production run is the factory's answer to an order line: this many of
// this, moving through these stages, by this date. The order says what was
// sold; the run says what is actually being made.
//
// Stages are rows rather than an enum. A hand-stitched ball and a
// thermo-bonded one do not go through the same steps, and a factory that
// changes its process should not need a code change and a migration to say
// so. WIN WEARS defines its own; nothing is invented here.

/// Where a run has got to.
enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// One step in this factory's process — cutting, printing, stitching,
/// whatever WIN WEARS actually does. Defined in the admin, never seeded:
/// a made-up list of stages would read as though somebody had surveyed the
/// factory floor.
model ProductionStage {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  displayOrder Int               @default(0)
  /// Retired stages stay, so a finished run still says where it went.
  active       Boolean           @default(true)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  runs         ProductionRun[]
  movedFrom    ProductionEvent[] @relation("StageFrom")
  movedTo      ProductionEvent[] @relation("StageTo")
  outputs      ProductionOutput[]
  inspections  QcInspection[]

  @@index([displayOrder])
  @@index([active])
}

model ProductionRun {
  id             String            @id @default(cuid())
  /// Human-quotable on the factory floor: WW-PR-2026-0001.
  reference      String            @unique
  title          String
  status         ProductionStatus  @default(PLANNED)

  /// Usually an order line. Optional, because a factory also makes stock,
  /// and a run with nowhere to point is better than a fake order to hang
  /// it on.
  orderId        String?
  orderItemId    String?
  productId      String?

  quantityPlanned Int

  /// Where it is now. Null before it starts, and null is honest: a run that
  /// has not begun is not sitting in the first stage.
  currentStageId String?

  ownerId        String?

  plannedStart   DateTime?
  plannedEnd     DateTime?
  /// Stamped by the first move into IN_PROGRESS and by completion, not
  /// typed in — the dates that matter for "was it late" are the ones the
  /// system observed.
  actualStart    DateTime?
  actualEnd      DateTime?

  notes          String?           @db.Text
  cancelReason   String?

  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  currentStage   ProductionStage?  @relation(fields: [currentStageId], references: [id], onDelete: SetNull)
  owner          User?             @relation("RunOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("RunAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  events         ProductionEvent[]
  outputs        ProductionOutput[]
  inspections    QcInspection[]
  stockMoves     StockMovement[]

  @@index([status])
  @@index([orderId])
  @@index([currentStageId])
  @@index([plannedEnd])
  @@index([status, plannedEnd])
  @@index([createdAt])
}

/// Units that came off the line. The same rule as a payment against an
/// order: progress is counted from what was recorded, never inferred from a
/// stage. A run sitting in "packing" is not evidence that anything is packed.
model ProductionOutput {
  id           String           @id @default(cuid())
  runId        String
  /// Which stage produced them, when the factory cares to record it.
  stageId      String?
  /// Units that passed.
  quantityGood Int              @default(0)
  /// Units that did not. Kept apart from good so a run that made its number
  /// twice over because half of it failed cannot look like a run that went
  /// well.
  quantityRejected Int          @default(0)
  note         String?
  recordedAt   DateTime         @default(now())
  recordedById String?

  createdAt    DateTime         @default(now())

  run          ProductionRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage        ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  recordedBy   User?            @relation("OutputRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([runId, recordedAt])
}

/// Every stage and status movement, kept forever. "How long did it sit in
/// stitching" is the question asked when an order runs late, and a single
/// currentStageId cannot answer it.
model ProductionEvent {
  id          String            @id @default(cuid())
  runId       String
  fromStageId String?
  toStageId   String?
  fromStatus  ProductionStatus?
  toStatus    ProductionStatus?
  byUserId    String?
  note        String?
  createdAt   DateTime          @default(now())

  run         ProductionRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromStage   ProductionStage?  @relation("StageFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     ProductionStage?  @relation("StageTo", fields: [toStageId], references: [id], onDelete: SetNull)
  by          User?             @relation("RunMovedBy", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
}

// ------------------------------------------------------- quality control --
//
// An inspection is a sample checked against this factory's own checkpoints.
// It is deliberately separate from production output: output counts what was
// made, an inspection judges a sample of it, and folding the two together
// would either double-count the units or lose the judgement.
//
// No checkpoint and no tolerance is seeded. A ball's weight, circumference,
// bounce and water absorption all have published standards, but which of them
// WIN WEARS tests, to what limits, and which are pass-or-fail is a fact about
// this factory. Inventing numbers here would put figures on a QC report that
// nobody at WIN WEARS ever agreed to, which is worse than an empty screen.

/// What kind of thing a checkpoint asks for.
enum QcCheckKind {
  /// A number, optionally with limits — weight in grams, circumference in cm.
  MEASUREMENT
  /// A yes or no from the person holding the ball — stitching sound, print
  /// aligned, no visible blemish.
  OBSERVATION
}

enum QcResultKind {
  PENDING
  PASSED
  FAILED
  /// Failed on something, and a person decided to let it through anyway.
  /// Kept distinct from PASSED, because "we shipped it knowing" is the
  /// sentence somebody needs to find later.
  CONCESSION
}

model QcCheckpoint {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  description  String?
  kind         QcCheckKind  @default(OBSERVATION)

  /// Grams, centimetres, percent — whatever WIN WEARS measures in. Free text
  /// because a unit list is a guess about what this factory tests.
  unit         String?
  /// Acceptable range. Null means nobody has set a limit, and then the
  /// inspector's own pass or fail stands — the system does not invent a
  /// threshold and then judge a ball against it.
  minValue     Decimal?     @db.Decimal(12, 3)
  maxValue     Decimal?     @db.Decimal(12, 3)

  /// A failure here fails the whole inspection outright. Anything else can be
  /// let through on a concession by a person who puts their name to it.
  critical     Boolean      @default(false)

  displayOrder Int          @default(0)
  /// Retired checkpoints stay, so an old inspection still says what it tested.
  active       Boolean      @default(true)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  results      QcResult[]

  @@index([displayOrder])
  @@index([active])
}

model QcInspection {
  id            String          @id @default(cuid())
  /// Quotable on a report: WW-QC-2026-0001.
  reference     String          @unique

  /// What was inspected. A run for work in progress, an order for a final
  /// check before it ships. Both optional, because a factory also inspects
  /// stock that is not yet promised to anyone.
  runId         String?
  orderId       String?
  stageId       String?

  /// How many were pulled and looked at, and how they came out. Counted by
  /// the inspector, never derived from the checkpoint results: a sample can
  /// fail on one ball out of twenty.
  sampleSize    Int             @default(0)
  quantityPassed Int            @default(0)
  quantityFailed Int            @default(0)

  /// Computed from the checkpoint results when the inspection is completed.
  result        QcResultKind    @default(PENDING)
  /// Set when a person overrules the computed result. The reason is required
  /// with it — an unexplained override is the thing nobody can answer for.
  overrideResult QcResultKind?
  overrideReason String?        @db.Text
  decidedById   String?

  inspectorId   String?
  inspectedAt   DateTime        @default(now())
  /// Locked once completed. An inspection that can be edited afterwards is
  /// not evidence of anything.
  completedAt   DateTime?

  notes         String?         @db.Text

  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  run           ProductionRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stage         ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  inspector     User?           @relation("Inspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  decidedBy     User?           @relation("QcDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("QcAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  results       QcResult[]

  @@index([result])
  @@index([runId])
  @@index([orderId])
  @@index([inspectedAt])
  @@index([result, inspectedAt])
}

/// One checkpoint's outcome within one inspection.
model QcResult {
  id           String       @id @default(cuid())
  inspectionId String
  checkpointId String

  /// What was measured, for a MEASUREMENT checkpoint.
  value        Decimal?     @db.Decimal(12, 3)
  /// Whether it passed. Computed from the limits when there are limits, and
  /// taken from the inspector when there are not.
  passed       Boolean
  /// Why it failed, in the inspector's words. The most useful field on the
  /// whole record when the same fault turns up again next month.
  note         String?

  createdAt    DateTime     @default(now())

  inspection   QcInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checkpoint   QcCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  /// One result per checkpoint per inspection: a second reading of the same
  /// check is a correction, not another data point to average.
  @@unique([inspectionId, checkpointId])
  @@index([checkpointId])
}

// ------------------------------------------------------------- inventory --
//
// Stock is a ledger, not a number. Every level on every screen is the sum of
// the movements underneath it, so a level and its history can never disagree
// — and when somebody asks why there are 40 fewer bladders than last week,
// the answer is on the record rather than in somebody's memory.
//
// A stored quantity that gets incremented is the same mistake as a stored
// "deposit paid" on an order: two copies of one fact, and the first correction
// makes them differ.

enum StockKind {
  /// Bought in and consumed — panels, bladders, thread, ink, cartons.
  MATERIAL
  /// Made here and sold.
  FINISHED
}

/// Why stock moved. The direction is fixed by the kind rather than by whoever
/// is typing, so an issue can never be entered as an increase.
enum StockMoveKind {
  /// In from a supplier.
  RECEIPT
  /// Out to the factory floor.
  ISSUE
  /// In from a production run.
  PRODUCTION
  /// Back in — unused material, or a customer return.
  RETURN
  /// Out for good: scrapped, damaged, failed inspection.
  WRITE_OFF
  /// A stocktake correction, and the only kind that may go either way. It
  /// always carries a reason, because "the count was wrong" needs to say how.
  ADJUSTMENT
}

/// Somewhere stock sits. Defined in the admin — a single-site factory may
/// only ever need one, and inventing a warehouse hierarchy for a business
/// that has one room would be furniture nobody asked for.
model StockLocation {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  description  String?
  displayOrder Int             @default(0)
  active       Boolean         @default(true)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  movements    StockMovement[]

  @@index([displayOrder])
  @@index([active])
}

model StockItem {
  id            String          @id @default(cuid())
  name          String
  /// The factory's own code for it. Unique, because two items sharing a code
  /// is how the wrong material gets issued.
  sku           String          @unique
  description   String?
  kind          StockKind       @default(MATERIAL)

  /// Metres, kilos, each, rolls — whatever this is counted in. Free text,
  /// because a fixed list is a guess about what WIN WEARS buys.
  unit          String?

  /// The catalogue product this is, for finished goods. Optional: plenty of
  /// finished stock is a size or colour the website does not list separately.
  productId     String?

  /// Warn below this. Null means nobody has set one, and then nothing is
  /// flagged — the system does not decide for a factory what "running low"
  /// means for its own materials.
  reorderLevel  Decimal?        @db.Decimal(14, 3)

  active        Boolean         @default(true)
  notes         String?         @db.Text

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  movements     StockMovement[]

  @@index([kind])
  @@index([active])
  @@index([name])
}

/// One movement in or out. Never edited and never deleted once written: a
/// ledger somebody can go back and tidy is not a ledger. A mistake is
/// corrected by an adjustment that says what it is correcting.
model StockMovement {
  id           String         @id @default(cuid())
  itemId       String
  locationId   String?
  kind         StockMoveKind

  /// Signed, and the sign is set from the kind rather than from the form.
  /// Summing this column is the whole of the stock level.
  quantity     Decimal        @db.Decimal(14, 3)

  /// What it was for. A run when material goes to the floor or finished goods
  /// come off it; an order when stock is picked for a customer.
  runId        String?
  orderId      String?

  /// A supplier's delivery note, an invoice number, a stocktake sheet.
  reference    String?
  note         String?

  occurredAt   DateTime       @default(now())
  recordedById String?
  createdAt    DateTime       @default(now())

  item         StockItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location     StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  run          ProductionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  recordedBy   User?          @relation("StockRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([itemId, occurredAt])
  @@index([kind])
  @@index([runId])
  @@index([orderId])
}

// -------------------------------------------------------------- shipping --
//
// A shipment is one consignment against one order. An order can go in several
// — a container now and the balance when the second run finishes is normal,
// not an edge case — so what is in each one is recorded line by line rather
// than assumed to be "the order".
//
// Nothing here decides that stock has left the building. Dispatching a
// shipment says the crates went on a lorry; taking finished goods off the
// shelf is a stock movement somebody records, for the same reason moving a
// production card does not make anything.

enum ShipmentStatus {
  /// Being picked and packed.
  PREPARING
  /// Packed, waiting on the carrier.
  READY
  /// Gone.
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Shipment {
  id             String           @id @default(cuid())
  /// Quotable to a customer chasing their delivery: WW-SH-2026-0001.
  reference      String           @unique
  status         ShipmentStatus   @default(PREPARING)

  orderId        String

  /// Free text, all of it. Which carriers WIN WEARS uses, what their services
  /// are called and which Incoterm was agreed are facts about this business
  /// and its contracts — a dropdown of guesses would be wrong for most of
  /// them and authoritative-looking for all of them.
  carrier        String?
  service        String?
  incoterm       String?

  trackingNumber String?
  /// Rendered as a link, so it is checked to be http or https before it is
  /// stored. An admin-editable field that becomes an href is exactly where a
  /// javascript: URL gets in.
  trackingUrl    String?

  /// Copied from the order when the shipment is raised, then editable: the
  /// delivery address for a part shipment is often not the one on the order.
  shipTo         String?          @db.Text

  packages       Int              @default(0)
  /// Kilos, as weighed. Null means nobody has weighed it, which is different
  /// from zero.
  weightKg       Decimal?         @db.Decimal(10, 3)
  dimensions     String?

  notes          String?          @db.Text
  internalNotes  String?          @db.Text

  /// What was promised, and what happened. Kept apart so "was it late" has an
  /// answer that does not depend on somebody's memory.
  expectedAt     DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  cancelReason   String?

  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("ShipmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  items          ShipmentItem[]
  events         ShipmentEvent[]

  @@index([status])
  @@index([orderId])
  @@index([dispatchedAt])
  @@index([status, expectedAt])
}

/// How much of one order line is in this consignment. The sum across every
/// shipment is what has actually gone, and it can never exceed what was sold.
model ShipmentItem {
  id           String     @id @default(cuid())
  shipmentId   String
  orderItemId  String
  quantity     Int

  shipment     Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// One line per order line per shipment: two rows for the same line in one
  /// consignment is a data entry slip, not two parcels.
  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ShipmentEvent {
  id         String          @id @default(cuid())
  shipmentId String
  fromStatus ShipmentStatus?
  toStatus   ShipmentStatus
  byUserId   String?
  note       String?
  createdAt  DateTime        @default(now())

  shipment   Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  by         User?           @relation("ShipmentMovedBy", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId, createdAt])
}

// ------------------------------------------------------------- ai support --
//
// The AI agent's own tables. Two models named in the brief are deliberately
// absent, because the brief also says to adapt rather than duplicate:
//
//   AILead    Ã¢â‚¬â€ every field it listed (leadScore, status, productId, quantity,
//               country) already describes the conversation it belongs to, and
//               a 1:1 side table would only add a join and a way for the two
//               copies to disagree. Those fields live on AIConversation.
//   AISetting Ã¢â‚¬â€ Setting is already key/value with a `group` column, so the AI
//               configuration is rows in group "ai". A second settings table
//               would need its own admin screen and its own audit trail.

/// How far a conversation has travelled as a sales lead.
enum AILeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

/// Scored from signals the customer volunteered (quantity, company, contact
/// details, customization). An ordering hint for the sales team, never a
/// decision Ã¢â‚¬â€ see lib/leadScore.ts.
enum AILeadScore {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AIMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum AIKnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AIEventType {
  CHAT_OPENED
  MESSAGE_SENT
  PRODUCT_RECOMMENDED
  PRODUCT_VIEWED
  QUOTE_STARTED
  QUOTE_SUBMITTED
  WHATSAPP_CLICKED
  HUMAN_ESCALATION
  CONVERSATION_COMPLETED
}

/// One visitor's chat. `sessionId` is an opaque id the browser generates and
/// keeps in sessionStorage; it is not the admin session cookie and carries no
/// authentication. Contact fields are filled only as the customer offers them.
model AIConversation {
  id           String       @id @default(cuid())
  sessionId    String       @unique

  // --- who, as far as they have said
  customerName String?
  company      String?
  country      String?
  email        String?
  whatsapp     String?

  // --- what they are after. Free text mirrors the catalogue's own approach.
  productId    String?
  categoryId   String?
  quantity     Int?
  size         String?
  customizationRequired Boolean?
  requirements String?      @db.Text

  status       AILeadStatus @default(NEW)
  leadScore    AILeadScore  @default(LOW)
  escalatedAt  DateTime?

  /// Counted rather than derived: the per-conversation message cap is a cost
  /// control, and it must hold without loading every message to check.
  messageCount Int          @default(0)
  tokensUsed   Int          @default(0)

  lastMessageAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// Attached to an account once someone recognises who this was. A
  /// conversation is anonymous until the visitor gives a name or an email,
  /// so these stay null for most of them.
  companyId    String?
  contactId    String?
  leadId       String?

  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// `company` above is what the visitor said; this is the account it was
  /// matched to.
  companyAccount Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactPerson  Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages     AIMessage[]
  events       AIEvent[]
  quotes       QuoteRequest[]

  @@index([status])
  @@index([leadScore])
  @@index([createdAt])
  @@index([status, leadScore, createdAt])
}

/// The transcript. Tool calls are stored too, so an admin reading a
/// conversation can see which facts the answer was actually built from.
model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text
  /// Set on TOOL rows: which tool ran.
  toolName       String?
  /// Tool arguments and results, kept for auditing an answer after the fact.
  metadata       Json?
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime      @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Admin-written answers the agent may quote: FAQs, policies, manufacturing
/// and customization notes. Only PUBLISHED rows are ever retrieved, so a
/// half-written policy cannot reach a customer.
model AIKnowledge {
  id        String            @id @default(cuid())
  title     String
  content   String            @db.Text
  category  String            @default("general")
  status    AIKnowledgeStatus @default(DRAFT)
  /// Higher wins when several entries match the same question.
  priority  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, priority])
  @@index([category])
}

/// Analytics. Deliberately thin Ã¢â‚¬â€ an event records that something happened and
/// which conversation it belonged to, not who the person was.
model AIEvent {
  id             String      @id @default(cuid())
  conversationId String?
  eventType      AIEventType
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
  @@index([conversationId])
}
