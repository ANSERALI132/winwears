# WIN WEARS — environment template
#
# Copy this file to .env and fill in real values. Commit this file; never
# commit .env (it is git-ignored, and there is a !.env.example rule so this
# template stays tracked).
#
#   cp .env.example .env
#
# The server refuses to start if anything required here is missing or
# malformed — it validates the whole file at boot rather than failing later.

# --- core -------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma.
#   local:    postgresql://postgres:PASSWORD@localhost:5432/winwears?schema=public
#   Neon:     postgresql://USER:PASSWORD@HOST.neon.tech/winwears?sslmode=require
#   Supabase: postgresql://postgres.REF:PASSWORD@HOST.supabase.com:5432/postgres
DATABASE_URL=

# Signs the admin session cookie. At least 32 characters, random, secret.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this signs everybody out.
AUTH_SECRET=

# How long an idle admin session lasts.
SESSION_TTL_HOURS=12

# Where the site is served from. Used for absolute URLs.
SITE_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Serve the static site from this process too. Handy locally; in production a
# CDN or nginx usually serves frontend/ and only /api and /admin come here.
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend

# Set to true ONLY when a reverse proxy really is in front of this process.
# It makes Express trust X-Forwarded-For, which rate limiting depends on.
TRUST_PROXY=false

# --- storage ----------------------------------------------------------------
# Product photographs and RFQ attachments never go into PostgreSQL.
# One of: local | cloudinary | s3 | supabase | vercel-blob
#
# Only "local" ships wired up. The others are stubs in src/lib/storage.ts that
# name the exact package and call to add — deliberately not guessed at, so an
# untested upload path cannot reach production.

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_PATH=/uploads
MAX_UPLOAD_MB=8

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_FOLDER=win-wears

# AWS S3 (or any S3-compatible bucket)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# --- rate limiting ----------------------------------------------------------
# Window shared by all three tiers, then a cap per tier.

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_FORM_MAX=10
RATE_LIMIT_LOGIN_MAX=8

# --- first admin account ----------------------------------------------------
# Read only by `npm run create-admin`, never by the server. Prefer setting
# these in your shell for one command rather than leaving them on disk:
#
#   PowerShell:
#     $env:ADMIN_EMAIL="you@example.com"; $env:ADMIN_PASSWORD="a long passphrase"
#     npm run create-admin
#
# Password must be at least 12 characters. There is no default account.

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- optional ---------------------------------------------------------------
# Used by the project's AI tooling in prompts/, not by the website.
ANTHROPIC_API_KEY=
