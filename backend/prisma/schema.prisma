// WIN WEARS — data model
//
// Everything the public site renders lives here, so the catalogue can be
// managed from /admin without touching source files. Frontend code holds no
// product data of its own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts --

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  activity     ActivityLog[]

  @@index([email])
}

/// Server-side sessions. Keeping them in the database means a session can be
/// revoked immediately — a signed cookie alone cannot be taken back.
model Session {
  sid       String   @id
  userId    String?
  data      String   @db.Text
  expiresAt DateTime

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

// -------------------------------------------------------------- catalogue --

model Category {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?  @db.Text
  image            String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)

  metaTitle        String?
  metaDescription  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         Product[]

  @@index([active, displayOrder])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())

  // --- basic
  productName      String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  fullDescription  String?       @db.Text
  categoryId       String
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0)

  // --- technical. Free text on purpose: the admin owns these values, and
  // constraining them to enums would mean a code change per new ball.
  construction           String?
  material               String?
  usage                  String?
  size                   String?
  weight                 String?
  bladder                String?
  panelCount             String?
  surface                String?
  stitching              String?
  technology             String?
  customizationAvailable Boolean @default(true)
  customizationNotes     String? @db.Text

  // --- commercial. B2B: price is optional and quoteOnly wins when set.
  price            Decimal?      @db.Decimal(10, 2)
  currency         String        @default("USD")
  priceLabel       String?
  moq              Int?
  quoteOnly        Boolean       @default(true)

  // --- seo
  metaTitle        String?
  metaDescription  String?
  keywords         String?
  ogImage          String?

  // --- system
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  /// Soft delete — Delete in the admin sets this so a mistake is recoverable.
  deletedAt        DateTime?

  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  features         ProductFeature[]
  specifications   ProductSpecification[]
  images           ProductImage[]
  quotes           QuoteRequest[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@index([productName])
  @@index([status, deletedAt, displayOrder])
}

model ProductFeature {
  id           String  @id @default(cuid())
  productId    String
  title        String
  description  String? @db.Text
  icon         String?
  displayOrder Int     @default(0)

  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model ProductSpecification {
  id           String  @id @default(cuid())
  productId    String
  label        String
  value        String
  displayOrder Int     @default(0)

  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

enum ImageType {
  MAIN
  GALLERY
  DETAIL
  CONSTRUCTION
  LIFESTYLE
  PACKAGING
}

model ProductImage {
  id           String    @id @default(cuid())
  productId    String
  /// Public URL produced by the storage driver, never a filesystem path.
  url          String
  /// Driver-specific handle, used to delete the stored object later.
  storageKey   String?
  altText      String?
  type         ImageType @default(GALLERY)
  isPrimary    Boolean   @default(false)
  width        Int?
  height       Int?
  bytes        Int?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
}

// ---------------------------------------------------------------- enquiry --

enum QuoteStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model QuoteRequest {
  id                    String      @id @default(cuid())
  name                  String
  company               String?
  country               String?
  email                 String
  whatsapp              String?
  productId             String?
  category              String?
  quantity              Int?
  size                  String?
  customizationRequired Boolean     @default(false)
  message               String?     @db.Text
  logoFile              String?
  designFile            String?
  status                QuoteStatus @default(NEW)
  /// Never returned by a public endpoint.
  internalNotes         String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  whatsapp  String?
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// --------------------------------------------------------------- settings --

/// Site-wide editable values (contact details, social links, default SEO).
/// Key/value rather than one wide row, so a new setting needs no migration.
model Setting {
  key       String   @id
  value     String   @db.Text
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt

  @@index([group])
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}
