{
  "name": "win-wears-backend",
  "version": "1.0.0",
  "private": true,
  "description": "WIN WEARS — REST API, admin dashboard and PostgreSQL data layer",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "node scripts/with-env.mjs prisma migrate dev",
    "migrate:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "create-admin": "node scripts/with-env.mjs tsx prisma/create-admin.ts",
    "studio": "node scripts/with-env.mjs prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/with-env.mjs node tests/run.mjs",
    "migrate:reset": "node scripts/with-env.mjs prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
