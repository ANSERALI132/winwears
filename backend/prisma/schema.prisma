// WIN WEARS — data model
//
// Everything the public site renders lives here, so the catalogue can be
// managed from /admin without touching source files. Frontend code holds no
// product data of its own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts --

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  activity     ActivityLog[]
  ownedLeads   Lead[]           @relation("LeadOwner")
  stageChanges LeadStageEvent[] @relation("StageMovedBy")
  assignedRfqs QuoteRequest[]   @relation("RfqAssignee")

  @@index([email])
}

/// Server-side sessions. Keeping them in the database means a session can be
/// revoked immediately — a signed cookie alone cannot be taken back.
model Session {
  sid       String   @id
  userId    String?
  data      String   @db.Text
  expiresAt DateTime

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

// -------------------------------------------------------------- catalogue --

model Category {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?  @db.Text
  image            String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)

  metaTitle        String?
  metaDescription  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         Product[]
  aiConversations  AIConversation[]
  leads            Lead[]

  @@index([active, displayOrder])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())

  // --- basic
  productName      String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  fullDescription  String?       @db.Text
  categoryId       String
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0)

  // --- technical. Free text on purpose: the admin owns these values, and
  // constraining them to enums would mean a code change per new ball.
  construction           String?
  material               String?
  usage                  String?
  size                   String?
  weight                 String?
  bladder                String?
  panelCount             String?
  surface                String?
  stitching              String?
  technology             String?
  customizationAvailable Boolean @default(true)
  customizationNotes     String? @db.Text

  // --- commercial. B2B: price is optional and quoteOnly wins when set.
  price            Decimal?      @db.Decimal(10, 2)
  currency         String        @default("USD")
  priceLabel       String?
  moq              Int?
  quoteOnly        Boolean       @default(true)

  // --- seo
  metaTitle        String?
  metaDescription  String?
  keywords         String?
  ogImage          String?

  // --- system
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  /// Soft delete — Delete in the admin sets this so a mistake is recoverable.
  deletedAt        DateTime?

  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  features         ProductFeature[]
  specifications   ProductSpecification[]
  images           ProductImage[]
  quotes           QuoteRequest[]
  aiConversations  AIConversation[]
  leads            Lead[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@index([productName])
  @@index([status, deletedAt, displayOrder])
}

model ProductFeature {
  id           String  @id @default(cuid())
  productId    String
  title        String
  description  String? @db.Text
  icon         String?
  displayOrder Int     @default(0)

  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model ProductSpecification {
  id           String  @id @default(cuid())
  productId    String
  label        String
  value        String
  displayOrder Int     @default(0)

  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

enum ImageType {
  MAIN
  GALLERY
  DETAIL
  CONSTRUCTION
  LIFESTYLE
  PACKAGING
}

model ProductImage {
  id           String    @id @default(cuid())
  productId    String
  /// Public URL produced by the storage driver, never a filesystem path.
  url          String
  /// Driver-specific handle, used to delete the stored object later.
  storageKey   String?
  altText      String?
  type         ImageType @default(GALLERY)
  isPrimary    Boolean   @default(false)
  width        Int?
  height       Int?
  bytes        Int?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
}

// ---------------------------------------------------------------- enquiry --

enum QuoteStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

/// Where a quote request came from. The agent's leads are worth telling apart
/// from the website form without reading the message.
enum QuoteSource {
  WEBSITE_FORM
  AI_AGENT
}

/// How soon somebody should look at an RFQ. Deliberately separate from the
/// lead score: the score is computed from what the customer told us, this is
/// what a human decided about it.
enum RfqPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model QuoteRequest {
  id                    String      @id @default(cuid())
  /// Human-quotable id shown to the customer and used in email: WW-RFQ-2026-0001.
  /// Nullable because rows created before it existed have none.
  reference             String?     @unique
  source                QuoteSource @default(WEBSITE_FORM)
  aiConversationId      String?
  /// Filled in when an enquiry is matched to an account. Nullable because a
  /// request arrives before anyone has decided who it is from, and refusing
  /// to store it until then would lose the enquiry.
  companyId             String?
  contactId             String?
  leadId                String?
  name                  String
  company               String?
  country               String?
  email                 String
  whatsapp              String?
  productId             String?
  category              String?
  quantity              Int?
  size                  String?
  customizationRequired Boolean     @default(false)
  message               String?     @db.Text
  logoFile              String?
  designFile            String?
  /// Where this request has got to in the inbox: has anyone dealt with it.
  /// The sales workflow itself lives on the linked Lead — an RFQ is the
  /// document, the lead is the opportunity, and giving each its own ten-stage
  /// pipeline would mean two that disagree.
  status                QuoteStatus @default(NEW)
  /// Who is dealing with it. Null is a real answer and worth reporting.
  assignedToId          String?
  /// What a human decided about urgency, as opposed to what the lead score
  /// computed from the customer's own words.
  priority              RfqPriority @default(NORMAL)
  followUpAt            DateTime?
  lastActivityAt        DateTime?
  /// Never returned by a public endpoint.
  internalNotes         String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  product               Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  aiConversation        AIConversation? @relation(fields: [aiConversationId], references: [id], onDelete: SetNull)
  /// `company` above is the name the customer typed; this is the account it
  /// was matched to. Both are kept — the text is evidence, the link is a
  /// judgement that can be corrected.
  companyAccount        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactPerson         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead                  Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo            User?           @relation("RfqAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([source])
  @@index([companyId])
  @@index([leadId])
  @@index([assignedToId])
  @@index([priority, status, createdAt])
  @@index([followUpAt])
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  /// The company name as the sender typed it. Kept alongside companyId:
  /// what they wrote is evidence, and matching it to an account is a
  /// judgement that can be wrong and revisited.
  company   String?
  whatsapp  String?
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  companyId String?
  contactId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  companyAccount Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactPerson  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([companyId])
}

// --------------------------------------------------------------- settings --

/// Site-wide editable values (contact details, social links, default SEO).
/// Key/value rather than one wide row, so a new setting needs no migration.
model Setting {
  key       String   @id
  value     String   @db.Text
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt

  @@index([group])
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

// --------------------------------------------------------------------- crm --
//
// The spine of the business: a company, the people at it, and the
// opportunities they represent. Everything the site already collects —
// quote requests, contact messages, assistant conversations — hangs off
// these, so one buyer is one timeline rather than three unrelated rows.
//
// Deliberately not built yet: orders, production, inventory, suppliers,
// shipping. Those models describe operations WIN WEARS has not configured,
// and a schema full of tables nobody writes to is harder to change later,
// not easier.

/// What kind of buyer this is. Free-form segments were considered and
/// rejected: a fixed list is what makes "show me every academy in the UK"
/// answerable, and OTHER covers the rest without inventing a category.
enum CompanySegment {
  DISTRIBUTOR
  CLUB
  ACADEMY
  SPORTS_BRAND
  WHOLESALER
  TOURNAMENT_ORGANIZER
  RETAILER
  OTHER
}

/// Where a company or lead came from. Recorded because "which source
/// produces buyers" is a question the owner will ask, and it cannot be
/// answered retrospectively.
enum LeadSource {
  WEBSITE_FORM
  AI_ASSISTANT
  WHATSAPP
  EMAIL
  REFERRAL
  TRADE_SHOW
  MANUAL
  OTHER
}

/// The pipeline. Ordered as the business actually runs, so a Kanban board
/// reads left to right without a lookup table.
enum LeadStage {
  NEW
  QUALIFIED
  CONTACTED
  DISCOVERY
  RFQ
  QUOTATION
  NEGOTIATION
  SAMPLE
  WON
  LOST
}

model Company {
  id           String          @id @default(cuid())
  name         String
  /// Stable handle for URLs and for matching an incoming enquiry to an
  /// existing account without depending on exact capitalisation.
  slug         String          @unique
  country      String?
  website      String?
  segment      CompanySegment  @default(OTHER)
  source       LeadSource      @default(OTHER)

  /// Admin-created labels. A string array rather than a Tag table and two
  /// joins: tags here are for filtering and colour, not for hanging data
  /// off, and renaming one is a single updateMany.
  tags         String[]        @default([])

  notes        String?         @db.Text
  /// Set from real activity, never guessed — the last time anything
  /// actually happened with this account.
  lastContactAt DateTime?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  contacts     Contact[]
  leads        Lead[]
  quotes       QuoteRequest[]
  messages     ContactMessage[]
  conversations AIConversation[]

  @@index([segment])
  @@index([country])
  @@index([name])
  @@index([lastContactAt])
}

/// A person at a company. §8: an account has an owner, a purchasing manager
/// and a designer, and treating each as a separate company loses the fact
/// that they are buying together.
model Contact {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Not unique: the same person can legitimately appear under two
  /// companies, and a duplicate is better than a rejected enquiry.
  email     String?
  whatsapp  String?
  phone     String?
  jobTitle  String?
  /// Who to contact by default when the company matters more than the person.
  isPrimary Boolean  @default(false)
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads     Lead[]
  quotes    QuoteRequest[]
  messages  ContactMessage[]
  conversations AIConversation[]

  @@index([companyId])
  @@index([email])
  @@index([whatsapp])
}

/// One opportunity. A company can have several at once — a repeat customer
/// negotiating one order while sampling another is normal.
model Lead {
  id            String      @id @default(cuid())
  /// Human-quotable, like the RFQ reference: WW-LEAD-2026-0001.
  reference     String?     @unique
  title         String
  companyId     String?
  contactId     String?
  stage         LeadStage   @default(NEW)
  source        LeadSource  @default(OTHER)

  /// Scored from signals the customer gave, by lib/leadScore.ts. Reuses the
  /// assistant's enum rather than introducing a second four-value scale that
  /// would drift from it.
  score         AILeadScore @default(LOW)
  /// A human disagreeing with the score wins, and the disagreement is kept
  /// rather than overwriting it — §10 asks the AI to explain itself, and an
  /// override is the most useful correction there is.
  scoreOverride AILeadScore?
  scoreReason   String?     @db.Text

  /// What they want, as far as anyone knows.
  productId     String?
  categoryId    String?
  quantity      Int?
  size          String?
  customizationRequired Boolean?
  requirements  String?     @db.Text

  /// Who is responsible. Null means nobody, which is itself worth reporting.
  ownerId       String?
  tags          String[]    @default([])

  lastActivityAt DateTime?
  nextFollowUpAt DateTime?
  /// Set once, when the lead first reaches WON or LOST.
  closedAt      DateTime?
  lostReason    String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner         User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  stageEvents   LeadStageEvent[]
  quotes        QuoteRequest[]
  conversations AIConversation[]

  @@index([stage])
  @@index([companyId])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@index([stage, score, lastActivityAt])
  @@index([createdAt])
}

/// Every stage movement, kept forever. §9 asks for movements to be logged;
/// this is also the only way to answer how long a lead sat in negotiation,
/// which is the question that follows.
model LeadStageEvent {
  id        String    @id @default(cuid())
  leadId    String
  fromStage LeadStage?
  toStage   LeadStage
  byUserId  String?
  note      String?
  createdAt DateTime  @default(now())

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  by        User?     @relation("StageMovedBy", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// ------------------------------------------------------------- ai support --
//
// The AI agent's own tables. Two models named in the brief are deliberately
// absent, because the brief also says to adapt rather than duplicate:
//
//   AILead    — every field it listed (leadScore, status, productId, quantity,
//               country) already describes the conversation it belongs to, and
//               a 1:1 side table would only add a join and a way for the two
//               copies to disagree. Those fields live on AIConversation.
//   AISetting — Setting is already key/value with a `group` column, so the AI
//               configuration is rows in group "ai". A second settings table
//               would need its own admin screen and its own audit trail.

/// How far a conversation has travelled as a sales lead.
enum AILeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

/// Scored from signals the customer volunteered (quantity, company, contact
/// details, customization). An ordering hint for the sales team, never a
/// decision — see lib/leadScore.ts.
enum AILeadScore {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AIMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum AIKnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AIEventType {
  CHAT_OPENED
  MESSAGE_SENT
  PRODUCT_RECOMMENDED
  PRODUCT_VIEWED
  QUOTE_STARTED
  QUOTE_SUBMITTED
  WHATSAPP_CLICKED
  HUMAN_ESCALATION
  CONVERSATION_COMPLETED
}

/// One visitor's chat. `sessionId` is an opaque id the browser generates and
/// keeps in sessionStorage; it is not the admin session cookie and carries no
/// authentication. Contact fields are filled only as the customer offers them.
model AIConversation {
  id           String       @id @default(cuid())
  sessionId    String       @unique

  // --- who, as far as they have said
  customerName String?
  company      String?
  country      String?
  email        String?
  whatsapp     String?

  // --- what they are after. Free text mirrors the catalogue's own approach.
  productId    String?
  categoryId   String?
  quantity     Int?
  size         String?
  customizationRequired Boolean?
  requirements String?      @db.Text

  status       AILeadStatus @default(NEW)
  leadScore    AILeadScore  @default(LOW)
  escalatedAt  DateTime?

  /// Counted rather than derived: the per-conversation message cap is a cost
  /// control, and it must hold without loading every message to check.
  messageCount Int          @default(0)
  tokensUsed   Int          @default(0)

  lastMessageAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// Attached to an account once someone recognises who this was. A
  /// conversation is anonymous until the visitor gives a name or an email,
  /// so these stay null for most of them.
  companyId    String?
  contactId    String?
  leadId       String?

  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// `company` above is what the visitor said; this is the account it was
  /// matched to.
  companyAccount Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactPerson  Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages     AIMessage[]
  events       AIEvent[]
  quotes       QuoteRequest[]

  @@index([status])
  @@index([leadScore])
  @@index([createdAt])
  @@index([status, leadScore, createdAt])
}

/// The transcript. Tool calls are stored too, so an admin reading a
/// conversation can see which facts the answer was actually built from.
model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text
  /// Set on TOOL rows: which tool ran.
  toolName       String?
  /// Tool arguments and results, kept for auditing an answer after the fact.
  metadata       Json?
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime      @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Admin-written answers the agent may quote: FAQs, policies, manufacturing
/// and customization notes. Only PUBLISHED rows are ever retrieved, so a
/// half-written policy cannot reach a customer.
model AIKnowledge {
  id        String            @id @default(cuid())
  title     String
  content   String            @db.Text
  category  String            @default("general")
  status    AIKnowledgeStatus @default(DRAFT)
  /// Higher wins when several entries match the same question.
  priority  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, priority])
  @@index([category])
}

/// Analytics. Deliberately thin — an event records that something happened and
/// which conversation it belonged to, not who the person was.
model AIEvent {
  id             String      @id @default(cuid())
  conversationId String?
  eventType      AIEventType
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
  @@index([conversationId])
}
